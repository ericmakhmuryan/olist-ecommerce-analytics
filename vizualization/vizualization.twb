  <worksheets>
    <worksheet name='Churn by Payment Method &amp; Installments.'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_master_clean' name='federated.0ai8qf80agytzy1fe3pgc1l1kqeo' />
          </datasources>
          <datasource-dependencies datasource='federated.0ai8qf80agytzy1fe3pgc1l1kqeo'>
            <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_0499496416960512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_churned] = 1 THEN 1 ELSE 0 END ) / COUNT([order_id])' />
            </column>
            <column caption='Installment Tier' datatype='string' name='[Calculation_0499496498049027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [max_payment_installments] = 1 THEN &quot;1x (Upfront)&quot;&#10;ELSEIF  [max_payment_installments] &gt;= 2 AND  [max_payment_installments] &lt;=6 THEN &quot;2x-6x (Short Term)&quot;&#10;ELSEIF  [max_payment_installments] &gt;= 7 AND  [max_payment_installments] &lt;=12 THEN &quot;7x-12x (Mid Term)&quot;&#10;ELSE &quot;13x+ (Long Term)&quot;&#10;END' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Is Churned' datatype='integer' name='[is_churned]' role='measure' type='quantitative' />
            <column caption='Max Payment Installments' datatype='real' name='[max_payment_installments]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0499496498049027]' derivation='None' name='[none:Calculation_0499496498049027:nk]' pivot='key' type='nominal' />
            <column-instance column='[primary_payment_type]' derivation='None' name='[none:primary_payment_type:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Primary Payment Type' datatype='string' name='[primary_payment_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0499496416960512]' derivation='User' name='[usr:Calculation_0499496416960512:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ai8qf80agytzy1fe3pgc1l1kqeo].[Action (Customer State)]'>
            <groupfilter function='level-members' level='[customer_state]' user:ui-action-filter='[Action1_DE342481275143F69864D26DB556C4CB]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0ai8qf80agytzy1fe3pgc1l1kqeo].[Exclusions (Installment Tier,Primary Payment Type)]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='level-members' level='[none:Calculation_0499496498049027:nk]' />
                <groupfilter function='level-members' level='[none:primary_payment_type:nk]' />
              </groupfilter>
              <groupfilter function='crossjoin'>
                <groupfilter function='member' level='[none:Calculation_0499496498049027:nk]' member='&quot;13x+ (Long Term)&quot;' />
                <groupfilter function='member' level='[none:primary_payment_type:nk]' member='%null%' />
              </groupfilter>
            </groupfilter>
          </filter>
