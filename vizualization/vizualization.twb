      <aliases enabled='yes' />
      <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_0499496416960512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_churned] = 1 THEN 1 ELSE 0 END ) / COUNT([order_id])' />
      </column>
      <column caption='Lost Revenue' datatype='real' name='[Calculation_0499496417636353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_churned] = 1 THEN [total_payment_value] ELSE 0 END)' />
      </column>
      <column caption='Delivery Delay Category' datatype='string' name='[Calculation_0499496417906690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [estimated_vs_actual_days] &gt; 5 THEN &quot;Delivered 5+ Days Early&quot;&#10;ELSEIF [estimated_vs_actual_days] &gt;= 0 AND [estimated_vs_actual_days] &lt;= 5 THEN &quot;Delivered On-Time&quot;&#10;ELSEIF [estimated_vs_actual_days] &gt;= -5 AND [estimated_vs_actual_days] &lt; 0 THEN &quot;Late (1-5 Days Delay)&quot;&#10;ELSE &quot;Severely Late (5+ Days Delay)&quot;&#10;END' />
      </column>
      <column caption='Installment Tier' datatype='string' name='[Calculation_0499496498049027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [max_payment_installments] = 1 THEN &quot;1x (Upfront)&quot;&#10;ELSEIF  [max_payment_installments] &gt;= 2 AND  [max_payment_installments] &lt;=6 THEN &quot;2x-6x (Short Term)&quot;&#10;ELSEIF  [max_payment_installments] &gt;= 7 AND  [max_payment_installments] &lt;=12 THEN &quot;7x-12x (Mid Term)&quot;&#10;ELSE &quot;13x+ (Long Term)&quot;&#10;END' />
      </column>
      <column caption='Freight Ratio %' datatype='real' default-format='p0.00%' name='[Calculation_0636385765326848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([freight_value]) / SUM([price])' />
      </column>
      <column caption='Freight Ratio Tier' datatype='string' name='[Calculation_0636385765662721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([freight_value] / [price]) &lt;= 0.10 THEN &quot;1. Low (&lt;10%)&quot;&#10;ELSEIF ([freight_value] / [price]) &gt; 0.10 AND ([freight_value] / [price]) &lt;= 0.25 THEN &quot;2. Moderate (10%-25%)&quot;&#10;ELSEIF ([freight_value] / [price]) &gt; 0.25 AND ([freight_value] / [price]) &lt;= 0.50 THEN &quot;3. High (25%-50%)&quot;&#10;ELSE &quot;4. Extreme (&gt;50%)&quot;&#10;END' />
      </column>
