    <worksheet name='Freight_Ratio_vs_Churn'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Freight-to-Price Ratio vs. Churn Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_master_clean' name='federated.0ai8qf80agytzy1fe3pgc1l1kqeo' />
          </datasources>
          <datasource-dependencies datasource='federated.0ai8qf80agytzy1fe3pgc1l1kqeo'>
            <column caption='Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_0499496416960512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_churned] = 1 THEN 1 ELSE 0 END ) / COUNT([order_id])' />
            </column>
            <column caption='Freight Ratio Tier' datatype='string' name='[Calculation_0636385765662721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([freight_value] / [price]) &lt;= 0.10 THEN &quot;1. Low (&lt;10%)&quot;&#10;ELSEIF ([freight_value] / [price]) &gt; 0.10 AND ([freight_value] / [price]) &lt;= 0.25 THEN &quot;2. Moderate (10%-25%)&quot;&#10;ELSEIF ([freight_value] / [price]) &gt; 0.25 AND ([freight_value] / [price]) &lt;= 0.50 THEN &quot;3. High (25%-50%)&quot;&#10;ELSE &quot;4. Extreme (&gt;50%)&quot;&#10;END' />
            </column>
            <column caption='Freight Value' datatype='real' name='[freight_value]' role='measure' type='quantitative' />
            <column caption='Is Churned' datatype='integer' name='[is_churned]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0636385765662721]' derivation='None' name='[none:Calculation_0636385765662721:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_category_name]' derivation='None' name='[none:product_category_name:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Price' datatype='real' name='[price]' role='measure' type='quantitative' />
            <column caption='Product Category Name' datatype='string' name='[product_category_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0499496416960512]' derivation='User' name='[usr:Calculation_0499496416960512:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ai8qf80agytzy1fe3pgc1l1kqeo].[none:product_category_name:nk]'>
            <groupfilter expression='COUNT([order_id]) &gt;= 1500' function='filter' user:ui-filter-by-field='true' user:ui-marker='filter-by'>
              <groupfilter function='level-members' level='[none:product_category_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
            </groupfilter>
          </filter>
