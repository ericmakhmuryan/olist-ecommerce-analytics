            <groupfilter function='level-members' level='[customer_state]' user:ui-action-filter='[Action1_DE342481275143F69864D26DB556C4CB]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0ai8qf80agytzy1fe3pgc1l1kqeo].[none:Calculation_0499496417906690:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Delivered 10+ Days Early&quot;</bucket>
              <bucket>&quot;Delivered On-Time&quot;</bucket>
              <bucket>&quot;Late (1-5 Days Delay)&quot;</bucket>
